---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import AdSense from '../../components/AdSense.astro';
import { getCategorySlug, getCategoryName } from '../../utils/slug';
import { getCategoryDescription, getCategoryGuides } from '../../utils/readingGuides';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const postCategories = allPosts.map(p => getCategorySlug(p.data.category));
  const uniqueCategorySlugs = [...new Set(postCategories)];

  return uniqueCategorySlugs.map(slug => {
    const filteredPosts = allPosts
      .filter(post => getCategorySlug(post.data.category) === slug)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    const firstRawName = filteredPosts[0]?.data.category;

    return {
      params: { category: slug },
      props: {
        categorySlug: slug,
        categoryName: getCategoryName(slug, firstRawName),
        posts: filteredPosts,
      },
    };
  });
}

const { categoryName, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = getCategoryDescription(categoryName);
const guides = getCategoryGuides(categoryName);
---

<BaseLayout
  title={`${categoryName} 아티클 모음`}
  description={description}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav aria-label="현재 위치" class="text-sm text-slate-600 mb-6">
      <a href={`${base}/categories/`} class="text-amber-800 underline underline-offset-4">분야별 전체 보기</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span aria-current="page">{categoryName}</span>
    </nav>
    <div class="mb-10">
      <div class="text-xs font-bold text-amber-800 uppercase tracking-wide mb-1">카테고리</div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">{categoryName}</h1>
      <p class="text-slate-700 text-base leading-relaxed mt-3 max-w-3xl">{description}</p>
      <p class="text-slate-600 text-sm mt-2">총 {posts.length}개의 글이 있습니다.</p>
      <nav aria-label="이 분야의 시작 안내" class="mt-5 p-5 bg-amber-50 border border-amber-200 rounded-2xl">
        <p class="text-base font-bold text-slate-900 mb-3">목적에 맞는 글부터 읽어보세요</p>
        <div class="flex flex-col items-start gap-3 text-base font-bold text-amber-800">
          {guides.map(guide => (
            <a href={`${base}/start/#${guide.id}`} class="underline underline-offset-4">{guide.title} →</a>
          ))}
          <a href={`${base}/start/`} class="underline underline-offset-4">시작 안내 전체 보기 →</a>
        </div>
      </nav>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {posts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200">
        <p class="text-slate-500 text-sm">해당 카테고리에 등록된 포스트가 아직 없습니다.</p>
      </div>
    )}

    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>
</BaseLayout>
