---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getDynamicCategories } from '../../utils/categories';
import siteConfig from '../../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const totalPosts = allPosts.length;
const { allCategories } = await getDynamicCategories(100);

const categoriesWithRecentPosts = allCategories.map(cat => {
  const postsInCat = allPosts
    .filter(p => p.data.category === cat.name)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return {
    ...cat,
    recentPosts: postsInCat.slice(0, 3),
  };
});
---

<BaseLayout
  title={`카테고리 허브 | ${siteConfig.site.name}`}
  description={`${siteConfig.site.name}의 모든 시니어 복지·연금·건강 카테고리 허브입니다.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 text-amber-900 text-xs font-bold mb-3 border border-amber-300 shadow-2xs">
        <span>📑 주제별 시니어 백과</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
        카테고리 허브
      </h1>
      <p class="text-slate-700 text-sm sm:text-base mt-2">
        총 {allCategories.length}개의 주요 분야에 {totalPosts}편의 시니어 알짜 가이드가 연재 중입니다.
      </p>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-10">
      {categoriesWithRecentPosts.map((cat, idx) => (
        <div class="bg-white rounded-2xl border-2 border-amber-200/80 p-6 shadow-xs hover:shadow-md hover:border-amber-400 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-100 text-amber-900 text-xs font-bold border border-amber-200">
                #{idx + 1}
              </span>
              <span class="text-xs font-bold text-amber-900 bg-amber-50 border border-amber-200 px-3 py-0.5 rounded-full">
                {cat.count}편
              </span>
            </div>

            <h2 class="text-xl font-bold text-slate-900 mb-2">
              <a href={cat.href} class="hover:text-amber-800 transition-colors">
                {cat.name}
              </a>
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 mb-5">
              {cat.count}편의 글이 작성되어 있습니다.
            </p>

            <!-- Latest 3 Articles preview -->
            <div class="space-y-2 pt-4 border-t border-amber-100">
              <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2">최신 글 목록</span>
              {cat.recentPosts.map(post => (
                <a
                  href={`${base}/blog/${post.slug}/`}
                  class="block text-xs sm:text-sm text-slate-700 hover:text-amber-800 transition-colors line-clamp-1 group"
                >
                  <span class="text-amber-400 group-hover:text-amber-600 mr-1.5">•</span>
                  <span>{post.data.title}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-amber-100">
            <a
              href={cat.href}
              class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-amber-800 hover:text-amber-900 hover:gap-1.5 transition-all"
            >
              <span>{cat.name} 전체 글 보기</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>
</BaseLayout>
