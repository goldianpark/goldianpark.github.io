---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThumbnailCard from '../components/ThumbnailCard.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getPostSummary } from '../utils/summary';
import { getDynamicCategories } from '../utils/categories';
import siteConfig from '../config/site';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const { allCategories } = await getDynamicCategories(100);
const categories = ['전체', ...allCategories.map(c => c.name)];
---

<BaseLayout
  title={`썸네일 갤러리 모아보기 | ${siteConfig.site.name}`}
  description={`${siteConfig.site.name}의 모든 시니어 복지·연금·건강 가이드를 한눈에 카드 썸네일로 빠르게 탐색해보세요.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold mb-3 border border-amber-300 shadow-2xs">
        <span>🖼️ 한눈에 보는 시니어 갤러리</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight">
        썸네일 갤러리 모아보기
      </h1>
      <p class="text-slate-700 text-sm sm:text-base mt-2 leading-relaxed">
        글의 핵심을 담은 큰 카드 썸네일을 통해 {sortedPosts.length}편의 시니어 알짜 정보를 직관적으로 둘러보세요.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-6" id="filter-buttons">
        {categories.map((cat, idx) => (
          <button
            data-category={cat}
            class={`px-4 py-2 text-xs sm:text-sm font-bold rounded-full transition-all cursor-pointer ${
              idx === 0
                ? 'bg-amber-700 text-white shadow-xs filter-btn-active'
                : 'bg-white text-slate-700 hover:bg-amber-50 hover:text-amber-900 border border-amber-200/90'
            }`}
          >
            {cat === '전체' ? `전체 (${sortedPosts.length})` : cat}
          </button>
        ))}
      </div>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    <!-- 4-Column Responsive Thumbnail Grid -->
    <div
      id="gallery-grid"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 my-10"
    >
      {sortedPosts.map(post => (
        <div data-post-category={post.data.category} class="gallery-item transition-all duration-300">
          <ThumbnailCard
            title={post.data.title}
            summary={getPostSummary(post)}
            description={post.data.description}
            slug={post.slug}
            category={post.data.category}
            pubDate={post.data.pubDate}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
          />
        </div>
      ))}
    </div>

    <!-- Empty Filter Result Message -->
    <div id="no-results-msg" class="hidden text-center py-16 bg-white rounded-2xl border-2 border-dashed border-amber-200">
      <p class="text-slate-500 text-sm">해당 카테고리에 등록된 아티클이 없습니다.</p>
    </div>

    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <script is:inline>
    const filterButtons = document.querySelectorAll('#filter-buttons button');
    const galleryItems = document.querySelectorAll('.gallery-item');
    const noResults = document.getElementById('no-results-msg');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category');

        filterButtons.forEach(btn => {
          btn.classList.remove('bg-amber-700', 'text-white', 'shadow-xs', 'filter-btn-active');
          btn.classList.add('bg-white', 'text-slate-700', 'hover:bg-amber-50', 'hover:text-amber-900', 'border', 'border-amber-200/90');
        });
        button.classList.add('bg-amber-700', 'text-white', 'shadow-xs', 'filter-btn-active');
        button.classList.remove('bg-white', 'text-slate-700', 'hover:bg-amber-50', 'hover:text-amber-900', 'border', 'border-amber-200/90');

        let visibleCount = 0;
        galleryItems.forEach(item => {
          const itemCat = item.getAttribute('data-post-category');
          if (category === '전체' || itemCat === category) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    });
  </script>
</BaseLayout>
