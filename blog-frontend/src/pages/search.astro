---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Extract popular tags
const allTags = allPosts.flatMap(post => post.data.tags || []);
const tagCountMap: Record<string, number> = {};
allTags.forEach(t => {
  tagCountMap[t] = (tagCountMap[t] || 0) + 1;
});
const popularTags = Object.keys(tagCountMap)
  .sort((a, b) => tagCountMap[b] - tagCountMap[a])
  .slice(0, 10);
---

<BaseLayout
  title={`아티클 실시간 검색 | ${siteConfig.site.name}`}
  description={`정부 지원금, 기초연금, 건강 팁 등 ${siteConfig.site.name}의 모든 아티클을 키워드로 실시간 검색하세요.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold mb-3 border border-amber-300 shadow-2xs">
        <span>🔍 시니어 알짜 검색</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight mb-3">
        원하는 시니어 정보를 검색해 보세요
      </h1>
      <p class="text-slate-700 text-sm sm:text-base">
        궁금하신 지원금, 연금 제도, 질환명을 입력하시면 실시간으로 찾아드립니다.
      </p>
    </div>

    <!-- Search Input Box -->
    <div class="max-w-3xl mx-auto mb-8">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="searchInput"
          placeholder="검색어 입력 (예: 65세 이상 혜택, 기초연금, 임플란트, 관절염...)"
          autofocus
          class="w-full pl-13 pr-12 py-3.5 sm:py-4 text-base sm:text-lg bg-white border-2 border-amber-200/90 focus:border-amber-600 rounded-2xl shadow-xs focus:outline-none focus:ring-4 focus:ring-amber-500/15 transition-all"
        />
        <button
          type="button"
          id="clearBtn"
          class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600"
          title="검색어 지우기"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Quick Tag Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mt-4">
        <span class="text-xs font-bold text-slate-500 mr-1">추천 키워드:</span>
        {popularTags.map(tag => (
          <button
            type="button"
            class="tag-pill px-3 py-1 bg-amber-50 hover:bg-amber-100 hover:text-amber-900 text-amber-900 border border-amber-200 text-xs font-bold rounded-lg transition-colors cursor-pointer"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- AdSense Top Banner -->
    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Search Status Bar -->
    <div class="flex items-center justify-between py-4 border-b border-amber-200 mb-6">
      <div id="searchCount" class="text-sm font-bold text-slate-800">
        전체 아티클을 불러오는 중...
      </div>
      <div id="searchQueryBadge" class="hidden text-xs text-slate-600 font-medium">
        검색어: <span class="font-bold text-amber-800" id="queryText"></span>
      </div>
    </div>

    <!-- Results Container -->
    <div id="resultsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-6">
      <!-- Live injected via JavaScript -->
    </div>

    <!-- No Results State -->
    <div id="noResults" class="hidden text-center py-16 bg-white rounded-2xl border-2 border-dashed border-amber-200 my-6">
      <p class="text-slate-500 text-sm sm:text-base">일치하는 아티클이 없습니다. 다른 키워드로 검색해보세요.</p>
    </div>

    <!-- Loading State -->
    <div id="loadingIndicator" class="text-center py-16 text-slate-400">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-amber-600 border-t-transparent mb-2"></div>
      <p class="text-xs sm:text-sm font-medium">검색 색인을 불러오는 중...</p>
    </div>

    <!-- AdSense Bottom Banner -->
    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <script is:inline define:vars={{ base }}>
    interface SearchItem {
      title: string;
      description: string;
      slug: string;
      category: string;
      categorySlug: string;
      tags: string[];
      pubDate: string;
      readingTime: string;
    }

    let searchIndex: SearchItem[] = [];
    const searchInput = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearBtn');
    const resultsGrid = document.getElementById('resultsGrid');
    const noResults = document.getElementById('noResults');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const searchCount = document.getElementById('searchCount');
    const searchQueryBadge = document.getElementById('searchQueryBadge');
    const queryText = document.getElementById('queryText');
    const tagPills = document.querySelectorAll('.tag-pill');

    // Fetch static search index JSON
    async function initSearch() {
      try {
        const res = await fetch(`${base}/search.json`);
        searchIndex = await res.json();
        if (loadingIndicator) loadingIndicator.classList.add('hidden');
        renderResults(searchIndex);
        updateStatus(searchIndex.length, '');
      } catch (err) {
        console.error('Failed to load search index:', err);
        if (searchCount) searchCount.innerText = '검색 색인을 불러오는 데 실패했습니다.';
      }
    }

    // Filter articles based on query
    function performSearch(query: string) {
      const q = query.trim().toLowerCase();

      if (clearBtn) {
        if (q.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }

      if (!q) {
        renderResults(searchIndex);
        updateStatus(searchIndex.length, '');
        return;
      }

      const filtered = searchIndex.filter(item => {
        const titleMatch = item.title.toLowerCase().includes(q);
        const descMatch = item.description.toLowerCase().includes(q);
        const catMatch = item.category.toLowerCase().includes(q);
        const tagsMatch = item.tags.some(t => t.toLowerCase().includes(q));
        return titleMatch || descMatch || catMatch || tagsMatch;
      });

      renderResults(filtered);
      updateStatus(filtered.length, query);
    }

    function updateStatus(count: number, query: string) {
      if (!searchCount) return;
      if (!query) {
        searchCount.innerText = `전체 ${count}개의 아티클`;
        if (searchQueryBadge) searchQueryBadge.classList.add('hidden');
      } else {
        searchCount.innerText = `검색 결과: 총 ${count}건`;
        if (searchQueryBadge && queryText) {
          queryText.innerText = `"${query}"`;
          searchQueryBadge.classList.remove('hidden');
        }
      }
    }

    function renderResults(posts: SearchItem[]) {
      if (!resultsGrid || !noResults) return;

      if (posts.length === 0) {
        resultsGrid.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');
      resultsGrid.innerHTML = posts.map(post => {
        const postUrl = `${base}/blog/${post.slug}/`;
        const catUrl = `${base}/categories/${post.categorySlug}/`;

        return `
          <article class="bg-white rounded-2xl border-2 border-amber-200/80 overflow-hidden shadow-2xs hover:shadow-md hover:border-amber-400 transition-all duration-200 flex flex-col group">
            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center justify-between gap-2 mb-3">
                <a href="${catUrl}" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-200 hover:bg-amber-200 transition-colors">
                  ${post.category}
                </a>
                <span class="text-xs text-slate-500 font-medium">⏱️ ${post.readingTime}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-amber-800 transition-colors line-clamp-2 mb-2 leading-snug">
                <a href="${postUrl}">${post.title}</a>
              </h3>
              <p class="text-sm text-slate-600 line-clamp-3 mb-4 flex-1 leading-relaxed">
                ${post.description}
              </p>
              <div class="pt-4 border-t border-amber-100 flex items-center justify-between text-xs text-slate-500">
                <time>${post.pubDate}</time>
                <a href="${postUrl}" class="text-amber-800 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  자세히 읽기 →
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    // Event Listeners
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        performSearch((e.target as HTMLInputElement).value);
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        (searchInput as HTMLInputElement).value = '';
        performSearch('');
        searchInput.focus();
      });
    }

    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const tag = pill.getAttribute('data-tag');
        if (tag && searchInput) {
          (searchInput as HTMLInputElement).value = tag;
          performSearch(tag);
        }
      });
    });

    // Check URL search parameters (e.g. ?q=keyword)
    window.addEventListener('DOMContentLoaded', () => {
      initSearch().then(() => {
        const params = new URLSearchParams(window.location.search);
        const qParam = params.get('q');
        if (qParam && searchInput) {
          (searchInput as HTMLInputElement).value = qParam;
          performSearch(qParam);
        }
      });
    });
  </script>
</BaseLayout>
