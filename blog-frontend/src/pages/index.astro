---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import ThumbnailCard from '../components/ThumbnailCard.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';
import { getPostSummary } from '../utils/summary';
import { getDynamicCategories } from '../utils/categories';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 12);

const { primaryCategories, secondaryCategories } = await getDynamicCategories(3);

const categories = [
  { name: '전체 글', href: `${base}/blog/` },
  { name: '갤러리', href: `${base}/gallery/` },
  ...primaryCategories.map(c => ({ name: c.name, href: c.href })),
  ...(secondaryCategories.length > 0 ? [{ name: `기타 (+${secondaryCategories.length})`, href: `${base}/categories/` }] : []),
];
---

<BaseLayout
  title={siteConfig.site.name}
  description={siteConfig.site.description}
  image={`${base}/images/hero-goldenlife.png`}
>
  <!-- Hero Section: Senior Couple Panoramic Banner with Center-Aligned Content & Menu -->
  <section class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-8 sm:pb-12">
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl lg:rounded-4xl border-2 border-amber-300/80 shadow-xl shadow-amber-900/10 bg-gradient-to-r from-amber-100 via-amber-50 to-orange-50 min-h-[440px] sm:min-h-[480px] md:min-h-[500px] flex items-center">
      
      <!-- 1. Background Panoramic Image (Senior Couple on the Right, Sunlight Clearing in the Center) -->
      <img
        src={`${base}/images/hero-goldenlife.png`}
        alt="골든라이프 - 행복한 시니어 부부의 황금빛 노후 산책"
        class="absolute inset-0 w-full h-full object-cover object-[78%_center] md:object-[82%_center] lg:object-right select-none"
        loading="eager"
        width="1024"
        height="341"
      />

      <!-- 2. Warm Sunlight Gradient Overlay (Clear in Center-Left for Readability, Transparent on Right for Senior Couple) -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#FAF8F5]/95 via-[#FAF8F5]/85 sm:via-[#FAF8F5]/70 md:via-[#FAF8F5]/55 to-transparent"></div>
      
      <!-- Mobile Bottom Subtle Gradient for Small Screens -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#FAF8F5]/80 via-transparent to-transparent sm:hidden"></div>

      <!-- 3. Foreground Content & Menus placed directly in the Center Clearing Area -->
      <div class="relative z-10 w-full max-w-xl sm:max-w-2xl lg:max-w-3xl px-5 sm:px-8 md:px-12 py-8 sm:py-10 flex flex-col justify-center text-left">
        
        <!-- Slogan Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-200/90 text-amber-950 border border-amber-400/80 text-xs sm:text-sm font-black mb-3.5 sm:mb-4 w-fit shadow-xs backdrop-blur-xs">
          <span>✨ {siteConfig.site.slogan}</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-3 sm:mb-4 drop-shadow-2xs">
          {siteConfig.site.shortName} <span class="text-amber-800 underline decoration-amber-400 decoration-wavy underline-offset-8">시니어 백과</span>
        </h1>

        <!-- Slogan Description -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-800 font-bold leading-relaxed mb-6 sm:mb-8 max-w-xl drop-shadow-2xs">
          기초연금·정부복지 혜택부터 은퇴 절세 상식, 100세 관절·혈관 건강까지 어르신의 행복하고 든든한 황금빛 삶을 함께합니다.
        </p>

        <!-- Category Menu Pills directly inside the Clearing Area -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
          {categories.map((cat, idx) => (
            <a
              href={cat.href}
              class={`px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl sm:rounded-2xl font-black text-sm sm:text-base border-2 shadow-xs transition-all duration-200 hover:scale-105 active:scale-95 ${
                idx === 0
                  ? 'bg-amber-700 hover:bg-amber-800 text-white border-amber-800 shadow-amber-900/20'
                  : 'bg-white/95 hover:bg-amber-700 hover:text-white text-slate-900 border-amber-300/90 hover:border-amber-700 backdrop-blur-sm'
              }`}
            >
              {cat.name}
            </a>
          ))}
        </div>

        <!-- Bottom Guidance Badge -->
        <div class="mt-5 sm:mt-6 flex items-center gap-2 text-xs sm:text-sm text-amber-950/80 font-extrabold">
          <span class="inline-block w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
          <span>어르신을 위한 맞춤형 복지·건강 실전 매거진</span>
        </div>

      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSense slotId="1234567890" type="top-banner" />
  </div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header with View Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight">최신 알짜 정보</h2>
        <p class="text-sm sm:text-base text-amber-900/80 font-medium mt-1">6070 어르신을 위한 정부 지원금, 연금, 건강 핵심 가이드</p>
      </div>

      <div class="flex items-center gap-3 self-start sm:self-auto">
        <!-- View Switcher Tabs -->
        <div class="inline-flex items-center p-1 bg-amber-100/70 rounded-xl border border-amber-200 text-xs font-bold text-slate-700">
          <button
            id="home-btn-feed"
            class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-white text-amber-900 shadow-xs transition-all cursor-pointer font-bold"
            title="피드형 (상세 요약)"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            <span>피드형</span>
          </button>
          <button
            id="home-btn-grid"
            class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-slate-600 hover:text-amber-900 transition-all cursor-pointer font-bold"
            title="썸네일 모아보기"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>🖼️ 썸네일형</span>
          </button>
        </div>

        <a href={`${base}/blog/`} class="hidden sm:inline-flex items-center gap-1 text-sm font-bold text-amber-800 hover:text-amber-900">
          전체보기 →
        </a>
      </div>
    </div>

    {recentPosts.length > 0 ? (
      <>
        <!-- 1. 카드 피드 뷰 (3열, 텍스트 중심) -->
        <div id="home-feed-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map(post => (
            <Card
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              category={post.data.category}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage}
              tags={post.data.tags}
            />
          ))}
        </div>

        <!-- 2. 컴팩트 썸네일 그리드 뷰 (4열, 썸네일 중심) -->
        <div id="home-grid-container" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
          {recentPosts.map(post => (
            <ThumbnailCard
              title={post.data.title}
              summary={getPostSummary(post)}
              description={post.data.description}
              slug={post.slug}
              category={post.data.category}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-16 bg-white rounded-2xl border-2 border-dashed border-amber-200">
        <p class="text-slate-500 text-base">아직 등록된 포스트가 없습니다.</p>
      </div>
    )}

    <div class="mt-12 text-center">
      <a
        href={`${base}/blog/`}
        class="inline-flex items-center gap-2 px-6 py-3.5 bg-amber-700 hover:bg-amber-800 text-white font-bold text-base rounded-xl shadow-xs transition-all"
      >
        <span>전체 글 목록 보러가기</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Bottom AdSense Slot -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>

  <script is:inline>
    // Tab switching between Feed and Thumbnail Grid
    const btnFeed = document.getElementById('home-btn-feed');
    const btnGrid = document.getElementById('home-btn-grid');
    const containerFeed = document.getElementById('home-feed-container');
    const containerGrid = document.getElementById('home-grid-container');

    function setView(mode) {
      if (!containerFeed || !containerGrid) return;
      if (mode === 'grid') {
        containerFeed.classList.add('hidden');
        containerGrid.classList.remove('hidden');

        btnGrid.classList.add('bg-white', 'text-amber-900', 'shadow-xs');
        btnGrid.classList.remove('text-slate-600');

        btnFeed.classList.remove('bg-white', 'text-amber-900', 'shadow-xs');
        btnFeed.classList.add('text-slate-600');
        localStorage.setItem('home_view_mode', 'grid');
      } else {
        containerGrid.classList.add('hidden');
        containerFeed.classList.remove('hidden');

        btnFeed.classList.add('bg-white', 'text-amber-900', 'shadow-xs');
        btnFeed.classList.remove('text-slate-600');

        btnGrid.classList.remove('bg-white', 'text-amber-900', 'shadow-xs');
        btnGrid.classList.add('text-slate-600');
        localStorage.setItem('home_view_mode', 'feed');
      }
    }

    const savedMode = localStorage.getItem('home_view_mode') || 'feed';
    if (savedMode === 'grid') setView('grid');

    if (btnFeed && btnGrid) {
      btnFeed.addEventListener('click', () => setView('feed'));
      btnGrid.addEventListener('click', () => setView('grid'));
    }
  </script>
</BaseLayout>
