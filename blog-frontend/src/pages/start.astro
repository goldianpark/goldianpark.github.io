---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveReadingGuides } from '../utils/readingGuides';
import { getCategorySlug } from '../utils/slug';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getCollection('blog', ({ data }) => !data.draft);
const guides = resolveReadingGuides(posts);
const formatDate = (date: Date) => new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(date);
---

<BaseLayout
  title={`목적별 시작 안내 | ${siteConfig.site.shortName}`}
  description="복지 신청, 연금 상담, 진료 전 준비, 일상생활 중 필요한 목적을 고르고 골든라이프의 관련 글을 순서대로 살펴보세요."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 break-keep">
    <nav aria-label="현재 위치" class="text-sm text-slate-600 mb-6">
      <a href={`${base}/`} class="text-amber-800 underline underline-offset-4">홈</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span aria-current="page">목적별 시작 안내</span>
    </nav>
    <header class="max-w-3xl mb-8">
      <p class="text-sm font-bold text-amber-800 mb-2">처음 오셨나요?</p>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-950 leading-tight">지금 필요한 정보부터 찾아보세요</h1>
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed mt-4">
        무엇을 먼저 읽을지 고민된다면 아래에서 목적을 골라보세요. 각 글을 언제 읽으면 좋을지 짧게 안내합니다.
      </p>
      <p class="text-base text-slate-600 leading-relaxed mt-3">
        각 글의 발행·수정일과 대상 조건을 살펴보고, 신청·상담 전에는 글에 연결된 공식 안내를 확인하세요.
      </p>
    </header>

    <nav aria-label="목적 바로가기" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-12">
      {guides.map((guide, index) => (
        <a href={`#${guide.id}`} class="flex items-center gap-3 p-4 rounded-xl bg-amber-50 border border-amber-300 text-base font-bold text-amber-950 hover:bg-amber-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-800">
          <span class="text-amber-700" aria-hidden="true">0{index + 1}</span>
          <span>{guide.title}</span>
          <span class="ml-auto" aria-hidden="true">↓</span>
        </a>
      ))}
    </nav>

    <div class="space-y-10">
      {guides.map((guide, index) => (
        <section id={guide.id} aria-labelledby={`${guide.id}-heading`} class="scroll-mt-28 rounded-2xl bg-white border-2 border-amber-200 p-5 sm:p-8">
          <p class="text-sm font-bold text-amber-800 mb-2">길잡이 0{index + 1}</p>
          <h2 id={`${guide.id}-heading`} class="text-xl sm:text-2xl font-extrabold text-slate-900">{guide.title}</h2>
          <p class="text-base text-slate-600 leading-relaxed mt-3">{guide.description}</p>
          <ol class="mt-6 divide-y divide-amber-100">
            {guide.articles.map(({ post, note }, articleIndex) => (
              <li class="py-5 first:pt-0 last:pb-0">
                <p class="text-sm font-semibold text-amber-800 mb-2">{articleIndex + 1}. {note}</p>
                <h3 class="text-base sm:text-lg font-bold leading-relaxed">
                  <a href={`${base}/blog/${post.slug}/`} class="text-slate-900 underline decoration-amber-300 underline-offset-4 hover:text-amber-800">{post.data.title}</a>
                </h3>
                <p class="text-sm text-slate-500 mt-2">
                  {post.data.updatedDate ? '수정일' : '발행일'}:
                  <time datetime={(post.data.updatedDate || post.data.pubDate).toISOString()}> {formatDate(post.data.updatedDate || post.data.pubDate)}</time>
                </p>
              </li>
            ))}
          </ol>
          <a href={`${base}/categories/${getCategorySlug(guide.category)}/`} class="inline-block mt-6 text-base font-bold text-amber-800 underline underline-offset-4">{guide.category} 전체 글 →</a>
        </section>
      ))}
    </div>

    <nav aria-label="다른 방법으로 글 찾기" class="mt-10 p-6 rounded-2xl bg-amber-50 border border-amber-200">
      <h2 class="text-lg font-bold text-slate-900 mb-3">다른 주제를 찾고 계신가요?</h2>
      <div class="flex flex-wrap gap-x-6 gap-y-3 text-base font-bold text-amber-800">
        <a href={`${base}/search/`} class="underline underline-offset-4">검색으로 찾기</a>
        <a href={`${base}/categories/`} class="underline underline-offset-4">분야별로 찾기</a>
        <a href={`${base}/blog/`} class="underline underline-offset-4">전체 글 보기</a>
      </div>
    </nav>
  </div>
</BaseLayout>
