---
import BaseLayout from './BaseLayout.astro';
import AdSense from '../components/AdSense.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SummaryCards from '../components/SummaryCards.astro';
import siteConfig from '../config/site';
import { getCategorySlug, getTagSlug } from '../utils/slug';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category?: string;
    tags?: string[];
    author?: string;
    readingTime?: string;
    faqs?: Array<{ question: string; answer: string }>;
    summaryCards?: Array<{ badge: string; title: string; desc: string; icon?: string }>;
  };
  headings: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: { title: string; slug: string; category?: string } | null;
  nextPost?: { title: string; slug: string; category?: string } | null;
}

const { frontmatter, headings, prevPost, nextPost } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  category = '정부지원금 & 복지',
  tags = [],
  author = siteConfig.site.author || '골든라이프 편집팀',
  readingTime = '5 min read',
  faqs = [],
  summaryCards,
} = frontmatter;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorySlug = getCategorySlug(category);

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  faqs={faqs}
  tags={tags}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-amber-700 transition-colors">홈</a>
      <span>/</span>
      <a href={`${base}/blog/`} class="hover:text-amber-700 transition-colors">블로그</a>
      <span>/</span>
      <a href={`${base}/categories/${categorySlug}/`} class="text-amber-700 hover:underline font-semibold">{category}</a>
    </nav>

    <!-- Article Header -->
    <header class="mb-6">
      <div class="flex items-center gap-2 mb-4">
        <a
          href={`${base}/categories/${categorySlug}/`}
          class="px-3.5 py-1.5 bg-amber-100 text-amber-900 border border-amber-300 text-xs sm:text-sm font-bold rounded-full hover:bg-amber-200 transition-colors"
        >
          {category}
        </a>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs sm:text-sm text-slate-500 font-medium">⏱️ 읽는 시간 {readingTime}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-950 tracking-tight leading-tight mb-5">
        {title}
      </h1>

      <p class="text-base sm:text-xl text-slate-700 leading-relaxed font-normal mb-6 bg-white p-5 rounded-2xl border border-amber-200/80 shadow-2xs">
        {description}
      </p>

      <!-- Author & Date Info with warm gold accent -->
      <div class="flex items-center justify-between flex-wrap gap-3 p-4 bg-amber-50/60 rounded-xl border border-amber-200/90 text-xs sm:text-sm text-slate-600">
        <div class="flex items-center gap-3">
          <img
            src={`${base}/favicon.png`}
            alt={`${siteConfig.site.shortName} 로고`}
            class="w-9 h-9 rounded-lg shadow-xs flex-shrink-0"
          />
          <div>
            <p class="font-bold text-slate-900 text-sm sm:text-base">{author}</p>
            <p class="text-slate-500 text-xs">발행일: {formattedDate} {updatedDate && `(최종 수정: ${new Intl.DateTimeFormat('ko-KR').format(updatedDate)})`}</p>
          </div>
        </div>

        <!-- 돋보기 & 글자 크기 조절기 (Senior Font Size Control Widget) -->
        <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-amber-200 shadow-2xs">
          <span class="text-xs sm:text-sm font-bold text-amber-950 flex items-center gap-1">
            <span>👓 글자 크기:</span>
          </span>
          <div class="inline-flex rounded-lg shadow-2xs" role="group" id="font-size-controls">
            <button
              type="button"
              id="btn-font-sm"
              class="px-2.5 py-1 text-xs font-bold text-slate-700 bg-white hover:bg-amber-100 rounded-l-lg border border-slate-200 transition-colors"
              title="글자 보통 크기"
            >
              보통
            </button>
            <button
              type="button"
              id="btn-font-md"
              class="px-2.5 py-1 text-xs font-bold text-amber-900 bg-amber-200/90 hover:bg-amber-300 border-t border-b border-slate-200 transition-colors"
              title="글자 크게 (어르신 추천)"
            >
              크게
            </button>
            <button
              type="button"
              id="btn-font-lg"
              class="px-2.5 py-1 text-xs font-bold text-slate-700 bg-white hover:bg-amber-100 rounded-r-lg border border-slate-200 transition-colors"
              title="글자 아주 크게"
            >
              아주 크게
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- 💡 글 내용 요약 3장 카드 (3-Key Takeaway Summary Cards) -->
    <SummaryCards cards={summaryCards} faqs={faqs} description={description} />

    <!-- Top AdSense Slot -->
    <AdSense slotId="1234567890" type="top-banner" />

    <!-- Table of Contents -->
    <TableOfContents headings={headings} />

    <!-- Article Markdown Content -->
    <div
      id="article-content-body"
      class="prose prose-slate max-w-none bg-white p-6 sm:p-10 rounded-2xl border-2 border-amber-100/90 shadow-sm leading-relaxed"
    >
      <slot />
    </div>

    <!-- Mid/In-Article AdSense Slot -->
    <AdSense slotId="2345678901" type="in-article" />

    <!-- FAQ Accordion Section (어르신 눈높이 고대비 디자인) -->
    {faqs && faqs.length > 0 && (
      <section class="my-10 p-6 sm:p-8 bg-gradient-to-br from-amber-50/70 to-orange-50/30 rounded-2xl border-2 border-amber-200/90 shadow-xs">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-6 flex items-center gap-2.5">
          <span class="text-2xl">❓</span>
          <span>어르신들이 가장 자주 묻는 질문 (FAQ)</span>
        </h2>
        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <div class="bg-white p-5 rounded-xl border border-amber-200/80 shadow-xs">
              <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2 flex items-start gap-2">
                <span class="text-amber-700 font-extrabold flex-shrink-0">Q{idx + 1}.</span>
                <span>{faq.question}</span>
              </h3>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed pl-6 border-l-2 border-amber-300">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 시니어 복지 상담 콜아웃 박스 -->
    <div class="my-10 p-6 bg-gradient-to-r from-amber-100/80 to-yellow-100/70 rounded-2xl border-2 border-amber-300 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="flex items-center gap-3.5">
        <span class="text-3xl">📞</span>
        <div>
          <h4 class="text-base sm:text-lg font-bold text-amber-950">정부 지원금 및 복지 혜택 유선 상담 안내</h4>
          <p class="text-xs sm:text-sm text-amber-900">
            신청이 어렵거나 자격 확인이 필요하시면 보건복지상담센터(국번없이 129) 또는 주민센터로 문의하세요.
          </p>
        </div>
      </div>
      <a
        href="tel:129"
        class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-amber-700 hover:bg-amber-800 text-white font-bold text-sm rounded-xl shadow-xs transition-all flex-shrink-0"
      >
        <span>📞 129 전화걸기</span>
      </a>
    </div>

    <!-- Tags List -->
    {tags.length > 0 && (
      <div class="my-8 flex flex-wrap items-center gap-2">
        <span class="text-xs sm:text-sm font-bold text-slate-600 mr-1">🏷️ 관련 태그:</span>
        {tags.map(tag => (
          <a
            href={`${base}/tags/${getTagSlug(tag)}/`}
            class="px-3 py-1 bg-amber-50 hover:bg-amber-100 hover:text-amber-800 text-amber-900 border border-amber-200 rounded-lg text-xs sm:text-sm font-semibold transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- Prev / Next Post Navigation Cards -->
    <nav class="my-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a
          href={`${base}/blog/${prevPost.slug}/`}
          class="p-5 bg-white hover:bg-amber-50/50 rounded-2xl border-2 border-slate-200 hover:border-amber-300 transition-all group flex flex-col shadow-xs"
        >
          <span class="text-xs font-bold text-slate-400 group-hover:text-amber-700 mb-1 flex items-center gap-1">
            <span>← 이전 글</span>
          </span>
          <span class="text-sm sm:text-base font-bold text-slate-800 group-hover:text-amber-900 line-clamp-2">
            {prevPost.title}
          </span>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}

      {nextPost && (
        <a
          href={`${base}/blog/${nextPost.slug}/`}
          class="p-5 bg-white hover:bg-amber-50/50 rounded-2xl border-2 border-slate-200 hover:border-amber-300 transition-all group flex flex-col items-end text-right shadow-xs"
        >
          <span class="text-xs font-bold text-slate-400 group-hover:text-amber-700 mb-1 flex items-center gap-1">
            <span>다음 글 →</span>
          </span>
          <span class="text-sm sm:text-base font-bold text-slate-800 group-hover:text-amber-900 line-clamp-2">
            {nextPost.title}
          </span>
        </a>
      )}
    </nav>

    <!-- Bottom AdSense Slot -->
    <AdSense slotId="4567890123" type="bottom-banner" />

    <!-- Related Posts -->
    <RelatedPosts currentSlug={Astro.params.slug || ''} category={category} tags={tags} />

    <!-- Giscus Comments -->
    <Giscus />
  </div>

  <!-- Senior Font Size Controller Script -->
  <script is:inline>
    (function() {
      const htmlEl = document.documentElement;
      const btnSm = document.getElementById('btn-font-sm');
      const btnMd = document.getElementById('btn-font-md');
      const btnLg = document.getElementById('btn-font-lg');
      const buttons = [btnSm, btnMd, btnLg];

      function updateButtonStyles(activeBtn) {
        buttons.forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-amber-200/90', 'text-amber-900');
            btn.classList.add('bg-white', 'text-slate-700');
          }
        });
        if (activeBtn) {
          activeBtn.classList.remove('bg-white', 'text-slate-700');
          activeBtn.classList.add('bg-amber-200/90', 'text-amber-900');
        }
      }

      function setFontSize(sizeClass, activeBtn) {
        htmlEl.classList.remove('senior-font-sm', 'senior-font-md', 'senior-font-lg');
        htmlEl.classList.add(sizeClass);
        localStorage.setItem('senior_font_preference', sizeClass);
        updateButtonStyles(activeBtn);
      }

      // Load preserved font size
      const saved = localStorage.getItem('senior_font_preference') || 'senior-font-md';
      if (saved === 'senior-font-sm') setFontSize('senior-font-sm', btnSm);
      else if (saved === 'senior-font-lg') setFontSize('senior-font-lg', btnLg);
      else setFontSize('senior-font-md', btnMd);

      if (btnSm) btnSm.addEventListener('click', () => setFontSize('senior-font-sm', btnSm));
      if (btnMd) btnMd.addEventListener('click', () => setFontSize('senior-font-md', btnMd));
      if (btnLg) btnLg.addEventListener('click', () => setFontSize('senior-font-lg', btnLg));
    })();
  </script>
</BaseLayout>
