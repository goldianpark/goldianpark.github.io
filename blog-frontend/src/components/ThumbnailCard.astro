---
import { getCategorySlug } from '../utils/slug';

export interface Props {
  title: string;
  summary?: string;
  description?: string;
  slug: string;
  category: string;
  pubDate: Date;
  readingTime?: string;
  heroImage?: string;
}

const {
  title,
  summary,
  description = '',
  slug,
  category,
  pubDate,
  readingTime = '5 min',
  heroImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorySlug = getCategorySlug(category);

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);

const thumbnailSrc = heroImage && heroImage !== '/images/default-hero.svg'
  ? heroImage
  : `${base}/og/${slug}.svg`;

const displaySummary = summary || description || '6070 어르신을 위한 핵심 복지·연금·건강 가이드입니다.';
---

<article class="group bg-white rounded-2xl border-2 border-amber-200/80 overflow-hidden shadow-xs hover:shadow-lg hover:border-amber-400 transition-all duration-300 flex flex-col">
  <!-- Thumbnail Link & Image -->
  <a href={`${base}/blog/${slug}/`} class="relative block overflow-hidden aspect-[1200/630] bg-slate-950">
    <img
      src={thumbnailSrc}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    <!-- Floating category pill overlay with warm gold styling -->
    <span class="absolute top-3 left-3 px-3 py-1 text-xs font-bold bg-slate-950/90 backdrop-blur-md text-amber-300 rounded-full border border-amber-400/40 shadow-xs">
      {category}
    </span>
  </a>

  <!-- Content Info: 시니어 친화 폰트 크기 및 여백 확대 -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <a href={`${base}/blog/${slug}/`} class="block group/text mb-3">
      <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover/text:text-amber-800 transition-colors line-clamp-2 mb-2 leading-snug">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 group-hover/text:text-slate-800 transition-colors line-clamp-2 leading-relaxed">
        {displaySummary}
      </p>
    </a>

    <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-amber-100">
      <span class="font-medium">{formattedDate}</span>
      <a
        href={`${base}/blog/${slug}/`}
        class="flex items-center gap-1 text-amber-800 font-bold hover:underline group-hover:translate-x-0.5 transition-transform"
      >
        <span>자세히 보기</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
