---
import { getCollection } from 'astro:content';
import { getRelatedPosts } from '../utils/readingGuides';

export interface Props {
  currentSlug: string;
  limit?: number;
}

const { currentSlug, limit = 3 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const currentPost = allPosts.find(post => post.slug === currentSlug);
const relatedPosts = currentPost ? getRelatedPosts(allPosts, currentPost, limit) : [];
---

{relatedPosts.length > 0 && (
  <section class="mt-14 pt-10 border-t border-slate-200/80">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
          <span>💡</span> 같은 주제로 이어 읽기
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          지금 읽은 글과 공통 주제가 있는 글을 모았습니다.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {relatedPosts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('ko-KR', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.pubDate);

        return (
          <a
            href={`${base}/blog/${post.slug}/`}
            class="group flex flex-col justify-between bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400/80 transition-all duration-200"
          >
            <!-- Dynamic SVG Thumbnail -->
            <div class="aspect-[1200/630] bg-slate-900 border-b border-slate-100 overflow-hidden">
              <img
                src={`${base}/og/${post.slug}.svg`}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="px-2.5 py-0.5 bg-amber-100 text-amber-900 border border-amber-200 font-bold rounded-full group-hover:bg-amber-700 group-hover:text-white transition-colors">
                    {post.data.category}
                  </span>
                  <span>{post.data.readingTime || '5 min'}</span>
                </div>

              <h4 class="font-bold text-slate-900 text-base leading-snug group-hover:text-amber-800 transition-colors line-clamp-2 mb-2">
                {post.data.title}
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-amber-100 flex items-center justify-between text-xs text-slate-500">
              <span>{formattedDate}</span>
              <span class="text-amber-800 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                자세히 읽기 &rarr;
              </span>
            </div>
          </div>
        </a>
      );
    })}
    </div>
  </section>
)}
