---
export interface SummaryCardItem {
  badge: string;
  title: string;
  desc: string;
  icon?: string;
}

export interface Props {
  cards?: SummaryCardItem[];
  faqs?: Array<{ question: string; answer: string }>;
  description?: string;
}

const { cards = [] } = Astro.props;
// Summaries must be written for the article. Do not relabel FAQs as benefit claims.
const displayCards = cards.filter(card => card.title && card.desc).slice(0, 3);
---

{displayCards.length > 0 && <section class="summary-cards-container my-8 p-6 sm:p-7 bg-gradient-to-br from-amber-50/90 via-orange-50/40 to-yellow-50/80 border-2 border-amber-300/80 rounded-2xl shadow-sm">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5 pb-4 border-b border-amber-200/80">
    <div class="flex items-center gap-2.5">
      <span class="text-2xl filter drop-shadow-xs">💡</span>
      <div>
        <h2 class="summary-header-title text-lg sm:text-xl font-extrabold text-amber-950 tracking-tight">
          먼저 확인할 내용
        </h2>
        <p class="summary-header-desc text-xs sm:text-sm text-amber-800/90 mt-0.5">
          이 글에서 다루는 조건과 주의할 점을 확인하세요.
        </p>
      </div>
    </div>
    <span class="inline-flex items-center self-start sm:self-auto px-3 py-1 rounded-full text-xs font-bold bg-amber-200/80 text-amber-900 border border-amber-300 shadow-2xs">
      핵심 안내
    </span>
  </div>

  <!-- 3장 카드 그리드 (items-stretch 로 모든 카드가 동일 높이 유지) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-stretch">
    {displayCards.map((card, idx) => (
      <div class="bg-white rounded-2xl p-5 border-2 border-amber-200/90 hover:border-amber-400 hover:shadow-md transition-all flex flex-col h-full group">
        <!-- 1. Card Top Badge & Index -->
        <div class="flex items-center justify-between mb-3 flex-shrink-0">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-amber-100/90 text-amber-900 border border-amber-200 shadow-2xs">
            <span class="text-sm">{card.icon || (idx === 0 ? '🎯' : idx === 1 ? '💰' : '📝')}</span>
            <span>{card.badge}</span>
          </span>
          <span class="text-xs font-black text-amber-600/70 group-hover:text-amber-600">
            0{idx + 1}
          </span>
        </div>

        <!-- 2. Card Title (제목 높이 일치로 하단 설명 상자 시작선 상단 정렬) -->
        <div class="min-h-[3.5rem] sm:min-h-[4.25rem] flex items-start mb-3.5 flex-shrink-0">
          <h3 class="summary-card-title text-base sm:text-lg font-black text-slate-900 leading-snug group-hover:text-amber-800 transition-colors">
            {card.title}
          </h3>
        </div>

        <!-- 3. Card Description Box (상단 정렬 + flex-1 로 가장 긴 글 기준 상자 크기 100% 동일 확장) -->
        <div class="flex-1 flex flex-col justify-start bg-amber-50/50 p-4 rounded-xl border border-amber-200/90">
          <p class="summary-card-desc text-xs sm:text-sm text-slate-700 leading-relaxed text-left">
            {card.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>}
