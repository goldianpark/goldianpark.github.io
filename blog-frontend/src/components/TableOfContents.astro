---
export interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;

// H2, H3 헤딩만 목차에 노출
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="my-6 p-5 sm:p-6 bg-amber-50/70 border-2 border-amber-200/80 rounded-2xl shadow-2xs">
    <div class="flex items-center gap-2 font-bold text-amber-950 text-sm sm:text-base mb-3.5">
      <svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span>📑 이 글의 핵심 목차</span>
    </div>
    <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
      {filteredHeadings.map(h => (
        <li class={h.depth === 3 ? 'ml-4 list-disc text-slate-600' : 'font-bold'}>
          <a
            href={`#${h.slug}`}
            class="hover:text-amber-800 hover:underline transition-colors block py-0.5"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
