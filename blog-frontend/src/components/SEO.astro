---
import siteConfig from '../config/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  canonicalURL?: string;
  faqs?: Array<{ question: string; answer: string }>;
  tags?: string[];
  gaId?: string;
  naverVerification?: string;
}

const {
  title,
  description,
  image = '/images/default-hero.svg',
  article = false,
  pubDate,
  updatedDate,
  author = siteConfig.site.author || '골든라이프 편집팀',
  canonicalURL = Astro.url.href,
  faqs,
  tags = [],
  gaId = siteConfig.seo.gaId || import.meta.env.PUBLIC_GA_ID || '',
  naverVerification = siteConfig.seo.naverVerification || import.meta.env.PUBLIC_NAVER_VERIFICATION || '',
} = Astro.props;

const siteTitle = siteConfig.site.shortName || '골든라이프';
let formattedTitle = title;

if (!title.includes(siteTitle)) {
  if (title.length + siteTitle.length + 3 <= 40) {
    formattedTitle = `${title} | ${siteTitle}`;
  } else {
    formattedTitle = title;
  }
}

const articleSlug = Astro.params.slug;
const resolvedImage = (article && articleSlug && (image === '/images/default-hero.svg' || !image))
  ? `/og/${articleSlug}.svg`
  : image;

const defaultSiteUrl = siteConfig.site.url || 'https://goldianpark.github.io';
const absoluteImageUrl = new URL(resolvedImage, Astro.site || defaultSiteUrl).href;
const siteUrl = Astro.site?.href || defaultSiteUrl;

// Structured Data: Article / BlogPosting
const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'image': [absoluteImageUrl],
  'datePublished': pubDate ? pubDate.toISOString() : new Date().toISOString(),
  'dateModified': updatedDate ? updatedDate.toISOString() : (pubDate ? pubDate.toISOString() : new Date().toISOString()),
  'author': {
    '@type': 'Person',
    'name': author,
  },
  'publisher': {
    '@type': 'Organization',
    'name': siteConfig.site.name,
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/favicon.png', siteUrl).href,
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
} : null;

// Structured Data: FAQPage
const faqSchema = (faqs && faqs.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer,
    },
  })),
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href={`${siteConfig.site.basePath.replace(/\/$/, '')}/favicon.png`} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:site_name" content={siteConfig.site.name} />
<meta property="og:locale" content="ko_KR" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absoluteImageUrl} />

<!-- Naver Search Advisor Verification -->
{naverVerification && (
  <meta name="naver-site-verification" content={naverVerification} />
)}

<!-- Google Search Console Verification -->
{siteConfig.seo.googleVerification && (
  <meta name="google-site-verification" content={siteConfig.seo.googleVerification} />
)}

<!-- Google AdSense Auto Ads Script -->
{siteConfig.monetization.adsenseClientId && (
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.monetization.adsenseClientId}`}
    crossorigin="anonymous"
  ></script>
)}

<!-- Structured Data (JSON-LD) -->
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<!-- Google Analytics 4 (GA4) -->
{gaId && (
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
  <script define:vars={{ gaId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', gaId);
  </script>
)}
