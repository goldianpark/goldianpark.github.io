---
import { getDynamicCategories } from '../utils/categories';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 상단에는 글 수가 가장 많은 대표 카테고리 최대 3개만 고정 배치하고, 나머지는 '더보기' 드롭다운으로 자동 분류
const { primaryCategories, secondaryCategories, allCategories } = await getDynamicCategories(3);
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-amber-200/70 transition-all duration-200 shadow-2xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-xs p-1">
        <img
          src={`${base}/favicon.png`}
          alt={`${siteConfig.site.shortName} 로고`}
          class="w-8 h-8 object-contain rounded-lg group-hover:scale-105 transition-transform"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-black text-slate-900 text-xl tracking-tight group-hover:text-amber-700 transition-colors">
          {siteConfig.site.shortName}
        </span>
        <span class="text-[11px] text-amber-800 font-bold tracking-wide -mt-1">{siteConfig.site.slogan}</span>
      </div>
    </a>

    <!-- Desktop Navigation (시니어 친화: 폰트 크기 확대 text-base, 클릭 영역 확대) -->
    <nav class="hidden md:flex items-center gap-1.5 text-base font-bold text-slate-700">
      <a
        href={`${base}/`}
        class="px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors"
      >
        홈
      </a>
      <a
        href={`${base}/blog/`}
        class="px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors"
      >
        전체 글
      </a>
      <a
        href={`${base}/gallery/`}
        class="px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors"
      >
        갤러리
      </a>

      <!-- 1. 대표 카테고리 (글 수가 많은 상위 3개 자동 노출) -->
      {primaryCategories.map(cat => (
        <a
          href={cat.href}
          class="px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors whitespace-nowrap"
        >
          {cat.name}
        </a>
      ))}

      <!-- 2. 기타 / 추가 서브 카테고리 드롭다운 (더보기) -->
      {secondaryCategories.length > 0 ? (
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1 px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors text-slate-700 cursor-pointer"
          >
            <span>더보기</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-700 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Popover -->
          <div class="absolute top-full left-0 pt-2 w-60 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl shadow-xl border-2 border-amber-200/90 py-2 overflow-hidden ring-1 ring-black/5">
              <div class="px-4 py-2 text-xs font-bold text-amber-900 bg-amber-50 uppercase tracking-wider border-b border-amber-200/80 flex items-center justify-between">
                <span>기타 카테고리</span>
                <span class="text-xs text-amber-700 font-extrabold">{secondaryCategories.length}개</span>
              </div>
              <div class="max-h-64 overflow-y-auto py-1">
                {secondaryCategories.map(cat => (
                  <a
                    href={cat.href}
                    class="flex items-center justify-between px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition-colors"
                  >
                    <span class="truncate">{cat.name}</span>
                    <span class="text-xs bg-amber-100 text-amber-900 rounded-full px-2.5 py-0.5 font-bold ml-2 flex-shrink-0">
                      {cat.count}편
                    </span>
                  </a>
                ))}
              </div>
              <div class="pt-1 border-t border-amber-100">
                <a
                  href={`${base}/categories/`}
                  class="block px-4 py-2.5 text-xs font-bold text-amber-800 hover:bg-amber-50 transition-colors"
                >
                  전체 카테고리 허브 보기 →
                </a>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <a
          href={`${base}/categories/`}
          class="px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors whitespace-nowrap text-slate-600 text-sm"
          title="카테고리 전체 목록"
        >
          카테고리
        </a>
      )}

      <a
        href={`${base}/about/`}
        class="px-3 py-2 rounded-xl hover:text-amber-800 hover:bg-amber-50 transition-colors"
      >
        소개
      </a>
    </nav>

    <!-- Right Action (Search / RSS / Contact / Mobile Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Search Button (Quick link to Search Page) -->
      <a
        href={`${base}/search/`}
        class="flex items-center gap-2 px-3 py-2 text-sm font-bold text-slate-700 bg-amber-50/80 hover:bg-amber-100 hover:text-amber-900 border border-amber-300/80 rounded-xl transition-all shadow-2xs group"
        title="블로그 글 검색 (Cmd + K)"
      >
        <svg class="w-4 h-4 text-amber-700 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline font-bold">검색</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono font-bold text-amber-900 bg-white border border-amber-200 rounded shadow-2xs">
          ⌘K
        </kbd>
      </a>

      <!-- Contact Button (Gold Theme) -->
      <a
        href={`${base}/contact/`}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-sm font-bold text-white bg-amber-700 hover:bg-amber-800 rounded-xl shadow-xs transition-all"
      >
        문의하기
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 text-slate-700 hover:text-amber-800 hover:bg-amber-50 rounded-xl transition-colors"
        aria-label="모바일 메뉴 열기"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden md:hidden border-t-2 border-amber-200/80 bg-white/95 backdrop-blur-md px-4 py-4 space-y-1.5 shadow-lg">
    <a href={`${base}/`} class="block px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-800">홈</a>
    <a href={`${base}/blog/`} class="block px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-800">전체 글</a>
    <a href={`${base}/gallery/`} class="block px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-800">갤러리</a>
    
    <div class="pt-3 pb-1 border-t border-amber-100 text-xs font-bold text-amber-900 uppercase tracking-wider px-3">
      주요 카테고리
    </div>
    {primaryCategories.map(cat => (
      <a href={cat.href} class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-800">
        <span>{cat.name}</span>
        <span class="text-xs text-amber-900 bg-amber-100 font-bold px-2.5 py-0.5 rounded-full">{cat.count}편</span>
      </a>
    ))}

    {secondaryCategories.length > 0 && (
      <>
        <div class="pt-3 pb-1 border-t border-amber-100 text-xs font-bold text-amber-900 uppercase tracking-wider px-3">
          기타 카테고리
        </div>
        {secondaryCategories.map(cat => (
          <a href={cat.href} class="flex items-center justify-between px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-amber-50 hover:text-amber-800">
            <span>{cat.name}</span>
            <span class="text-xs text-amber-800 font-bold">{cat.count}편</span>
          </a>
        ))}
      </>
    )}

    <div class="pt-3 border-t border-amber-100 space-y-1">
      <a href={`${base}/categories/`} class="block px-3.5 py-2.5 rounded-xl text-sm font-bold text-amber-800 hover:bg-amber-50">
        📑 전체 카테고리 허브 둘러보기 →
      </a>
      <a href={`${base}/about/`} class="block px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 hover:bg-amber-50">소개</a>
      <a href={`${base}/contact/`} class="block px-3.5 py-2.5 rounded-xl text-base font-bold text-slate-800 hover:bg-amber-50">문의하기</a>
    </div>
  </div>
</header>

<script is:inline define:vars={{ base }}>
  // Mobile Hamburger Toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  if (mobileToggle && mobileDrawer) {
    mobileToggle.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });
  }

  // Global Shortcut Cmd+K / Ctrl+K to navigate to /search/
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (!window.location.pathname.includes('/search')) {
        window.location.href = `${base}/search/`;
      } else {
        const input = document.getElementById('searchInput');
        if (input) input.focus();
      }
    }
  });
</script>
