---
import { getDynamicCategories } from '../utils/categories';
import siteConfig from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 상단에는 글 수가 가장 많은 대표 카테고리 최대 3개만 고정 배치하고, 나머지는 '더보기' 드롭다운으로 자동 분류
const { primaryCategories, secondaryCategories } = await getDynamicCategories(3);

// 카테고리별 직관적인 고시인성 이모티콘 매핑 (노령층 눈높이 UX)
function getCategoryIcon(name: string): string {
  if (name.includes('지원금') || name.includes('복지')) return '🏛️';
  if (name.includes('연금') || name.includes('절세')) return '💰';
  if (name.includes('건강') || name.includes('일상')) return '🩺';
  if (name.includes('AI') || name.includes('생산성')) return '⚡';
  return '📌';
}

// 축약된 친화적 메뉴 라벨 생성
function getShortCategoryLabel(name: string): string {
  if (name.includes('정부지원금')) return '정부지원금';
  if (name.includes('연금 & 절세')) return '연금·절세';
  if (name.includes('시니어 건강')) return '시니어건강';
  return name;
}
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-amber-300/80 transition-all duration-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-2 sm:gap-4">
    <!-- 1. Gold Logo & Brand Title -->
    <a href={`${base}/`} class="flex items-center gap-3 group flex-shrink-0">
      <img
        src={`${base}/images/logo.svg`}
        alt={`${siteConfig.site.shortName} 로고`}
        class="w-11 h-11 sm:w-12 sm:h-12 object-contain drop-shadow-sm group-hover:scale-105 transition-transform"
      />
      <div class="flex flex-col">
        <span class="font-black text-slate-950 text-xl sm:text-2xl tracking-tight group-hover:text-amber-800 transition-colors leading-none">
          {siteConfig.site.shortName}
        </span>
        <span class="text-[11px] sm:text-xs text-amber-800 font-extrabold tracking-tight mt-1 hidden sm:block">
          시니어 복지·연금·건강 백과
        </span>
      </div>
    </a>

    <!-- 2. Desktop Navigation (노령층 친화: 이모티콘 + 큰 글씨 + 줄바꿈 절대 방지 whitespace-nowrap) -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-base xl:text-lg font-black text-slate-800 flex-shrink-0">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl hover:bg-amber-100/90 hover:text-amber-950 transition-all whitespace-nowrap"
      >
        <span class="text-xl">🏠</span>
        <span>홈</span>
      </a>

      <!-- 대표 카테고리 3대 핵심 메뉴 (고시인성 이모티콘 적용) -->
      {primaryCategories.map(cat => (
        <a
          href={cat.href}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl hover:bg-amber-100/90 hover:text-amber-950 transition-all whitespace-nowrap"
        >
          <span class="text-xl">{getCategoryIcon(cat.name)}</span>
          <span>{getShortCategoryLabel(cat.name)}</span>
        </a>
      ))}

      <a
        href={`${base}/blog/`}
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl hover:bg-amber-100/90 hover:text-amber-950 transition-all whitespace-nowrap"
      >
        <span class="text-xl">📚</span>
        <span>전체글</span>
      </a>

      <a
        href={`${base}/gallery/`}
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl hover:bg-amber-100/90 hover:text-amber-950 transition-all whitespace-nowrap"
      >
        <span class="text-xl">🖼️</span>
        <span>갤러리</span>
      </a>

      <!-- 더보기 드롭다운 (소개, 문의, 기타 카테고리) -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1 px-3 py-2 rounded-xl hover:bg-amber-100/90 hover:text-amber-950 transition-all text-slate-700 cursor-pointer whitespace-nowrap"
        >
          <span>📂 더보기</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-800 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Popover -->
        <div class="absolute top-full right-0 pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <div class="bg-white rounded-2xl shadow-xl border-2 border-amber-300 py-2 overflow-hidden ring-1 ring-black/5">
            <div class="px-4 py-2 text-xs font-bold text-amber-900 bg-amber-50 uppercase tracking-wider border-b border-amber-200/80">
              추가 메뉴 &amp; 정보
            </div>
            <div class="py-1">
              <a
                href={`${base}/categories/`}
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition-colors"
              >
                <span>📑</span>
                <span>카테고리 전체 허브</span>
              </a>
              <a
                href={`${base}/about/`}
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition-colors"
              >
                <span>💡</span>
                <span>골든라이프 소개 (About)</span>
              </a>
              <a
                href={`${base}/contact/`}
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition-colors"
              >
                <span>✉️</span>
                <span>운영진 문의 및 피드백</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- 3. Right Action Buttons (검색 & 복지상담 직통 다이얼) -->
    <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
      <!-- 검색 버튼 (크고 선명한 테두리) -->
      <a
        href={`${base}/search/`}
        class="flex items-center gap-2 px-3.5 sm:px-4 py-2 text-sm sm:text-base font-black text-amber-950 bg-amber-50 hover:bg-amber-100 border-2 border-amber-300 rounded-xl transition-all shadow-2xs whitespace-nowrap group"
        title="글 검색하기"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-800 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="font-extrabold whitespace-nowrap">검색</span>
      </a>

      <!-- 보건복지부 상담 직통 버튼 (시니어 편의) -->
      <a
        href="tel:129"
        class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-sm sm:text-base font-black text-white bg-amber-700 hover:bg-amber-800 rounded-xl shadow-xs transition-all whitespace-nowrap flex-shrink-0"
        title="보건복지상담센터 국번없이 129"
      >
        <span>📞 129 상담</span>
      </a>

      <!-- Mobile Menu Toggle Button (노령층을 위해 크고 시원하게) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 text-slate-800 hover:text-amber-800 hover:bg-amber-100/70 rounded-xl border border-amber-200 transition-colors"
        aria-label="메뉴 열기"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (크고 쾌적한 터치 영역) -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden border-t-2 border-amber-200 bg-white/98 backdrop-blur-md px-4 py-5 space-y-2 shadow-xl">
    <div class="grid grid-cols-2 gap-2 mb-3">
      <a href={`${base}/`} class="flex items-center gap-2 p-3 rounded-xl text-base font-black text-slate-900 bg-amber-50 hover:bg-amber-100">
        <span class="text-xl">🏠</span>
        <span>홈으로</span>
      </a>
      <a href={`${base}/blog/`} class="flex items-center gap-2 p-3 rounded-xl text-base font-black text-slate-900 bg-amber-50 hover:bg-amber-100">
        <span class="text-xl">📚</span>
        <span>전체 글</span>
      </a>
      <a href={`${base}/gallery/`} class="flex items-center gap-2 p-3 rounded-xl text-base font-black text-slate-900 bg-amber-50 hover:bg-amber-100">
        <span class="text-xl">🖼️</span>
        <span>갤러리</span>
      </a>
      <a href={`${base}/search/`} class="flex items-center gap-2 p-3 rounded-xl text-base font-black text-slate-900 bg-amber-50 hover:bg-amber-100">
        <span class="text-xl">🔍</span>
        <span>글 검색</span>
      </a>
    </div>

    <div class="pt-3 pb-1 border-t border-amber-200 text-xs font-black text-amber-900 uppercase tracking-wider px-1">
      🏛️ 시니어 3대 핵심 분야
    </div>
    {primaryCategories.map(cat => (
      <a href={cat.href} class="flex items-center justify-between px-4 py-3 rounded-xl text-base sm:text-lg font-black text-slate-900 hover:bg-amber-100 border border-amber-200/60 shadow-2xs">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl">{getCategoryIcon(cat.name)}</span>
          <span>{cat.name}</span>
        </div>
        <span class="text-xs text-amber-950 bg-amber-200 font-extrabold px-3 py-1 rounded-full">{cat.count}편</span>
      </a>
    ))}

    <div class="pt-3 border-t border-amber-200 space-y-2">
      <a href="tel:129" class="flex items-center justify-center gap-2 w-full py-3 bg-amber-700 text-white font-black text-base rounded-xl shadow-xs">
        <span>📞 보건복지상담센터 (129) 전화걸기</span>
      </a>
      <div class="flex items-center justify-around text-sm font-bold text-slate-700 pt-2">
        <a href={`${base}/categories/`} class="hover:text-amber-800">카테고리 전체</a>
        <span>•</span>
        <a href={`${base}/about/`} class="hover:text-amber-800">소개</a>
        <span>•</span>
        <a href={`${base}/contact/`} class="hover:text-amber-800">문의하기</a>
      </div>
    </div>
  </div>
</header>

<script is:inline define:vars={{ base }}>
  // Mobile Hamburger Toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  if (mobileToggle && mobileDrawer) {
    mobileToggle.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });
  }

  // Global Shortcut Cmd+K / Ctrl+K to navigate to /search/
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (!window.location.pathname.includes('/search')) {
        window.location.href = `${base}/search/`;
      } else {
        const input = document.getElementById('searchInput');
        if (input) input.focus();
      }
    }
  });
</script>
