---
import { getCategorySlug } from '../utils/slug';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  readingTime?: string;
  heroImage?: string;
  tags?: string[];
}

const {
  title,
  description,
  pubDate,
  slug,
  category,
  readingTime = '5 min read',
  heroImage = '/images/default-hero.svg',
  tags = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorySlug = getCategorySlug(category);

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<article class="bg-white rounded-2xl border-2 border-amber-200/80 overflow-hidden shadow-xs hover:shadow-md hover:border-amber-400 transition-all duration-200 flex flex-col group">
  <div class="p-6 sm:p-7 flex-1 flex flex-col">
    <div class="flex items-center justify-between gap-2 mb-3">
      <a
        href={`${base}/categories/${categorySlug}/`}
        class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-200 hover:bg-amber-200 transition-colors"
      >
        {category}
      </a>
      <span class="text-xs text-slate-500 font-medium">⏱️ {readingTime}</span>
    </div>

    <!-- Title (시니어 친화 크기) -->
    <h3 class="text-xl font-black text-slate-900 group-hover:text-amber-800 transition-colors line-clamp-2 mb-2.5 leading-snug">
      <a href={`${base}/blog/${slug}/`}>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm sm:text-base text-slate-700 line-clamp-3 mb-4 flex-1 leading-relaxed">
      {description}
    </p>

    <!-- Footer Meta -->
    <div class="pt-4 border-t border-amber-100 flex items-center justify-between text-xs sm:text-sm text-slate-500">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <a
        href={`${base}/blog/${slug}/`}
        class="text-amber-800 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
      >
        자세히 읽기 →
      </a>
    </div>
  </div>
</article>
